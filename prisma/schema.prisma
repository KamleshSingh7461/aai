generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The main entity. Every agreement belongs to exactly one university.
model University {
  id         String      @id @default(cuid())
  name       String
  address    String?
  city       String?
  state      String?
  pincode    String?
  country    String      @default("India")
  /// Other spellings seen on documents (JSON string[]), used for auto-matching.
  aliases    Json        @default("[]")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  agreements Agreement[]
}

/// Our companies (EUSAI, ACI, FGSN, SDN, ...) and any other counterparties.
model Company {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  isGroup    Boolean     @default(true)
  aliases    Json        @default("[]")
  createdAt  DateTime    @default(now())
  agreements Agreement[]
}

/// One uploaded or scanned file, stored untouched. A file may contain
/// several agreements (e.g. a Transfer Letter followed by a Valuation Letter).
model SourceDocument {
  id            String      @id @default(cuid())
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  sha256        String
  pageCount     Int
  source        String      // "upload" | "scan"
  status        String      @default("processing") // processing | done | failed
  error         String?
  model         String?
  rawExtraction Json?
  uploadedBy    String?
  createdAt     DateTime    @default(now())
  /// Bumped when reading starts or finishes; used to spot interrupted reads.
  updatedAt     DateTime    @default(now()) @updatedAt
  agreements    Agreement[]
}

model Agreement {
  id                String         @id @default(cuid())
  sourceDocumentId  String
  sourceDocument    SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  pageStart         Int
  pageEnd           Int
  universityId      String?
  university        University?    @relation(fields: [universityId], references: [id])
  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id])
  type              String
  typeLabel         String
  title             String?
  /// Date exactly as printed, plus the parsed date (null if unreadable).
  agreementDateText String?
  agreementDate     DateTime?
  academicYear      String?
  termText          String?
  termYears         Int?
  autoRenewal       Boolean?
  /// Calculated from agreementDate + termYears; never read from the document.
  expiryDate        DateTime?
  summary           String         @default("")
  /// Full extracted record (verbatim values, page numbers, confidence).
  data              Json
  /// Inconsistencies for a human to check. Never auto-corrected.
  flags             Json           @default("[]")
  fullText          String         @default("")
  status            String         @default("needs_review") // needs_review | approved
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]

  @@index([universityId])
  @@index([companyId])
  @@index([status])
}

model AuditLog {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  action      String
  field       String?
  oldValue    String?
  newValue    String?
  user        String?
  createdAt   DateTime  @default(now())
}
